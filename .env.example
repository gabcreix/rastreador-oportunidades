# Copia este archivo a .env y rellena los valores reales. .env nunca se sube al repo.

# Ruta del archivo SQLite (requiere disco persistente en el VPS)
DB_PATH=./rastreador.sqlite

# Clave de la API de Anthropic (capa inferida, Etapa 2 de detección — Fase 5)
ANTHROPIC_API_KEY=

# Modelo económico a usar para la detección
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Retención por defecto de oportunidades descartadas (días)
RETENCION_DESCARTADAS_DIAS=30
